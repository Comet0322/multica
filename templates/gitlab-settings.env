# Settings for gitlab-settings.sh. No secrets here: the token comes from the
# environment and PG_PASSWORD is generated in GitLab.
GITLAB_URL=https://gitlab.example.internal
PROJECT=company/multica
CI_CONFIG_PATH=company/ci/multica.gitlab-ci.yml
DEFAULT_BRANCH=company/main          # leave empty before company/main exists
PROTECTED_BRANCHES="company/* baseline/*"
PROTECTED_TAGS="v*"
AGENT_USER=                          # the agent's account, kept at Developer

# Company mirrors and proxy (DIAGNOSE.md decides these)
GOPROXY=https://goproxy.example.internal
npm_config_registry=https://npm.example.internal/
COREPACK_NPM_REGISTRY=https://npm.example.internal
APT_MIRROR=                          # optional: replaces http://deb.debian.org in the CI image build
APK_MIRROR=                          # optional: replaces dl-cdn.alpinelinux.org/alpine in app image builds
BUILD_PROXY=                         # optional: outbound proxy for image builds
NO_PROXY_HOSTS=
IMAGE_REPO=                          # optional: where built images go (default: the project registry)
PUSH_REGISTRY=                       # optional: registry host for IMAGE_REPO; PUSH_PASSWORD is set by hand
PUSH_USER=
KANIKO_EXTRA=                        # optional extra Kaniko flags
GO_TEST_P=                           # optional: from the runner's CPU limit
VITEST_WORKERS=
