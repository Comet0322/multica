      "proxy-addr@>=2.0.0 <2.0.8": "2.0.8",
      "qs@>=6.0.0 <6.16.1": "6.16.1",
      "react-router@>=7.0.0 <7.18.2": "7.18.2",
      "smol-toml@>=1.0.0 <1.9.0": "1.9.0",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "tar@>=7.0.0 <7.5.21": "7.5.21",
      "tmp@>=0.2.0 <0.2.6": "0.2.6",
      "turbo@>=2.0.0 <2.9.14": "2.9.14",
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "vitest@>=4.0.0 <4.1.12": "4.1.12",
      "ws@>=7.0.0 <7.5.11": "7.5.11",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "zod@>=4.0.0 <4.6.6": "4.6.6",
      "katex": "0.18.2",
      "vite": "8.1.6",
      "electron-builder-squirrel-windows": "26.18.0"
    },
    "patchedDependencies": {
      "expo-modules-core@57.0.21": "apps/mobile/patches/expo-modules-core@57.0.21.patch"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "knip": "^6.32.2",
    "pg": "^8.20.0",
    "turbo": "^2.5.4",
    "typescript": "catalog:",
    "vite": "8.1.6"
  }
