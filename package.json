{
  "name": "multica",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "turbo dev --filter=@multica/web",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "turbo lint",
    "clean": "turbo clean && rm -rf node_modules",
    "ui:add": "cd packages/ui && npx shadcn@latest add"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@types/react": "catalog:",
      "@types/react-dom": "catalog:",
      "@xmldom/xmldom": "^0.8.13",
      "dompurify": "^3.4.17",
      "katex": "0.18.10",
      "postcss": "8.5.26",
      "uuid": "11.1.1",
      "shell-quote": "1.9.0",
      "minimatch@3>brace-expansion": "1.1.21",
      "minimatch@5>brace-expansion": "2.1.4",
      "minimatch@9>brace-expansion": "2.1.4",
      "minimatch@10>brace-expansion": "5.0.12",
      "protobufjs": "^7.6.1",
      "linkify-it": "^5.0.2",
      "sharp": "^0.35.5",
      "path-to-regexp@8": "^8.4.0",
      "react-router": "^7.18.2",
      "image-size": "^2.0.3",
      "js-yaml@4": "^4.3.2",
      "picomatch@2": "^2.3.2",
      "picomatch@4": "^4.0.4",
      "undici@7": "^7.29.1",
      "vite": "^8.1.6",
      "source-map-js": "^1.2.2",
      "browserslist": "^4.28.7",
      "fflate@0.4": "^0.4.9",
      "@opentelemetry/core@2": "^2.8.0",
      "smol-toml": "^1.9.0",
      "@humanfs/node": "^0.16.8",
      "baseline-browser-mapping": "^2.11.0",
      "@vitest/mocker": "^4.1.12"
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "knip": "^6.32.2",
    "turbo": "^2.9.14",
    "typescript": "catalog:",
    "vite": "^8.1.6"
  }
}
