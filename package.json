      "image-size@>=2.0.0 <2.0.3": "2.0.3",
      "ip-address@>=10.0.0 <10.7.4": "10.7.4",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "linkify-it@>=5.0.0 <5.0.2": "5.0.2",
      "mermaid@>=11.0.0 <11.16.1": "11.16.1",
