# Build from the repository root:
#   docker build -f deploy/sandbox/Dockerfile.manager -t multica-sandbox-manager:<tag> .
ARG GO_IMAGE=golang:1.27.3-alpine

FROM ${GO_IMAGE} AS builder
WORKDIR /src/server
COPY server/go.mod server/go.sum ./
RUN go mod download
COPY server/ ./
RUN CGO_ENABLED=0 go build -ldflags "-s -w" -o /out/sandbox-manager ./cmd/sandbox-manager

FROM alpine:3.21
RUN apk add --no-cache ca-certificates \
	&& adduser -D -u 65532 manager
COPY --from=builder /out/sandbox-manager /usr/local/bin/sandbox-manager
USER manager
# Readiness is /readyz on the pod listener; the cluster probes it. The image's
# own check is liveness: /healthz on the pod listener.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
	CMD wget -q -O /dev/null "http://127.0.0.1${SANDBOX_MANAGER_LISTEN:-:8790}/healthz" || exit 1
ENTRYPOINT ["/usr/local/bin/sandbox-manager"]
