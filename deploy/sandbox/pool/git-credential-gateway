#!/bin/sh
# git credential helper for the pooled sandbox image. The system gitconfig
# enables it for the git gateway's host only (see Dockerfile.pool), so the
# task token is never offered to any other server.
#
# The manager puts the task's gateway token in the agent's environment as
# GIT_GATEWAY_TOKEN. The gateway reads it as the password of HTTP Basic auth;
# the user name is not checked.
#
# Without a token (the daemon's own clones and fetches carry none) it answers
# nothing, and the gateway identifies the pod by its address for reads.
[ "${1:-}" = get ] || exit 0
[ -n "${GIT_GATEWAY_TOKEN:-}" ] || exit 0
printf 'username=agent\npassword=%s\n' "$GIT_GATEWAY_TOKEN"
