# Build from the repository root:
#   docker build -f deploy/sandbox/Dockerfile.broker -t multica-sandbox-manager:<tag> .
ARG GO_IMAGE=golang:1.27.3-alpine

FROM ${GO_IMAGE} AS builder
WORKDIR /src/server
COPY server/go.mod server/go.sum ./
RUN go mod download
COPY server/ ./
RUN CGO_ENABLED=0 go build -ldflags "-s -w" -o /out/sandbox-broker ./cmd/sandbox-broker

FROM alpine:3.21
RUN apk add --no-cache ca-certificates \
	&& adduser -D -u 65532 broker
COPY --from=builder /out/sandbox-broker /usr/local/bin/sandbox-broker
USER broker
# Readiness is /readyz on the pod listener; the cluster probes it.
ENTRYPOINT ["/usr/local/bin/sandbox-broker"]
