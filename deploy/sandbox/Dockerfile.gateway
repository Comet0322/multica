# The git/MCP gateway image (cmd/git-gateway). Build from the repository root:
#   docker build -f deploy/sandbox/Dockerfile.gateway -t multica-git-gateway:<tag> .
# Settings are GIT_GATEWAY_* environment variables (see POOL.md); the GitLab
# administrator token is mounted as a file (GIT_GATEWAY_GITLAB_TOKEN_FILE).
ARG GO_IMAGE=golang:1.27.3-alpine

FROM ${GO_IMAGE} AS builder
WORKDIR /src/server
COPY server/go.mod server/go.sum ./
RUN go mod download
COPY server/ ./
RUN CGO_ENABLED=0 go build -ldflags "-s -w" -o /out/git-gateway ./cmd/git-gateway

FROM alpine:3.21
RUN apk add --no-cache ca-certificates && adduser -D -u 65532 gateway
COPY --from=builder /out/git-gateway /usr/local/bin/git-gateway
USER gateway
# The gateway has no health endpoint of its own; it is alive when it accepts
# connections on its listener.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
	CMD nc -z 127.0.0.1 "$(echo "${GIT_GATEWAY_LISTEN:-:8081}" | sed "s/.*://")" || exit 1
ENTRYPOINT ["/usr/local/bin/git-gateway"]
